        "    ax1.set_ylim(0.5, 0.8)\n",
        "\n",
        "    ax2 = ax1.twinx()\n",
        "    ax2.plot(x, y_right, color='r')\n",
        "    ax2.set_ylabel(y_right_name, color='r', fontsize=16, fontweight='bold')\n",
        "    if 'DI' in y_right_name:\n",
